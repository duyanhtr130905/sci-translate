# ── Ollama ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2
OLLAMA_TEMPERATURE=0.3
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=120
OLLAMA_MAX_INPUT_LENGTH=2048
OLLAMA_BATCH_SIZE=4

# ── Neo4j ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123

# ── ChromaDB ──
CHROMADB_HOST=localhost
CHROMADB_PORT=8001

# ── PostgreSQL ──
DATABASE_URL=postgresql://sci_user:sci_pass@localhost:5432/sci_translate

# ── RabbitMQ / Celery ──
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672/
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── JWT ──
JWT_SECRET_KEY=changethis_to_random_string_32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
