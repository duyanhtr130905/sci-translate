# Copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên git!

# ── PostgreSQL ──
DATABASE_URL=postgresql://sci_user:sci_pass@localhost:5432/sci_translate
POSTGRES_USER=sci_user
POSTGRES_PASSWORD=sci_pass
POSTGRES_DB=sci_translate

# ── Neo4j ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── RabbitMQ ──
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672/

# ── ChromaDB ──
CHROMADB_HOST=localhost
CHROMADB_PORT=8001

# ── AI Service ──
MODEL_NAME=Helsinki-NLP/opus-mt-en-vi
MODEL_PATH=./models
AI_DEVICE=cpu        # "cpu" hoặc "cuda"
AI_BATCH_SIZE=8
AI_MAX_LENGTH=512

# ── Drupal ──
DRUPAL_HASH_SALT=changethis_to_random_string_64chars
DRUPAL_DB_URL=mysql://drupal:drupal@localhost:3306/drupal

# ── Superset ──
SUPERSET_SECRET_KEY=changethis_to_random_string
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin

# ── JWT ──
JWT_SECRET_KEY=changethis_to_random_string_32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ── Frontend ──
REACT_APP_AI_SERVICE_URL=http://localhost:8000
REACT_APP_DRUPAL_URL=http://localhost:80
REACT_APP_SUPERSET_URL=http://localhost:8088
REACT_APP_USE_MOCK=false
