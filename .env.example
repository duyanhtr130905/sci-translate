# ============================================================================
# SCI-Translate — Environment Variables
# Copy file này thành .env và điền giá trị thực tế
# KHÔNG commit file .env lên git!
# ============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=sci_user
POSTGRES_PASSWORD=sci_pass_CHANGE_ME
POSTGRES_DB=sci_translate
POSTGRES_PORT=5432

# ── Neo4j ───────────────────────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123_CHANGE_ME
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ── ChromaDB ───────────────────────────────────────────────────────────────
CHROMADB_PORT=8001
# (Tuỳ chọn) Bật authentication cho ChromaDB
# CHROMADB_TOKEN=your_token_here
# CHROMADB_AUTH_PROVIDER=chromadb.auth.token_authn.TokenAuthenticationServerProvider

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass_CHANGE_ME

# ── RabbitMQ ───────────────────────────────────────────────────────────────
RABBITMQ_USER=sci_rabbit
RABBITMQ_PASSWORD=rabbit_pass_CHANGE_ME
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ── AI Service ─────────────────────────────────────────────────────────────
AI_SERVICE_PORT=8000
AI_DEVICE=cpu
AI_BATCH_SIZE=8
AI_MAX_LENGTH=512

# ── Ollama (chạy trên máy host, AI Service gọi qua host.docker.internal) ─
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURE=0.3
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=120
OLLAMA_MAX_INPUT_LENGTH=2048
OLLAMA_BATCH_SIZE=4

# ── Drupal ─────────────────────────────────────────────────────────────────
DRUPAL_PORT=80
DRUPAL_DB_NAME=drupal
DRUPAL_HASH_SALT=CHANGE_THIS_TO_RANDOM_64CHAR_STRING_abc123def456ghi789

# ── Apache Superset ────────────────────────────────────────────────────────
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=CHANGE_THIS_TO_RANDOM_SECRET_KEY
SUPERSET_DB_NAME=superset
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin_CHANGE_ME
SUPERSET_ADMIN_EMAIL=admin@sci-translate.local
SUPERSET_ADMIN_FIRSTNAME=Admin
SUPERSET_ADMIN_LASTNAME=SCI

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_THIS_TO_RANDOM_32CHAR_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ── Frontend ──────────────────────────────────────────────────────────────
REACT_APP_AI_SERVICE_URL=http://localhost:8000
REACT_APP_DRUPAL_URL=http://localhost:80
REACT_APP_SUPERSET_URL=http://localhost:8088
REACT_APP_USE_MOCK=false
